---
// src/components/Footer.astro
import type { Props } from '@astrojs/starlight/props';
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
const currentYear = new Date().getFullYear();
---

<footer class="custom-footer">
  <div class="footer-content">
    
    <div class="footer-brand">
      <div class="logo">
        <img src="/brand/lens/favicon.svg" alt="" width="44" height="44" />
        <span>All About SBOM</span>
      </div>
      <p>Publishing informational content and guidelines to help you navigate modern software supply chains.</p>
    </div>

    <div class="footer-links">
      <div class="link-group">
        <h4>Resources</h4>
        <a href="/sbom_basics">SBOM Basics</a>
        <a href="/tooling">Tools</a>
        <a href="/regulations">Regulations & Frameworks</a>
      </div>
      <div class="link-group">
        <h4>Use Cases</h4>
        <a href="/use-cases/security">Cybersecurity</a>
        <a href="/use-cases/license">License Compliance</a>
        <a href="/use-cases/technical-debt">Technical Debt Management</a>
        <a href="/use-cases/supplier">Supplier Transparency</a>
      </div>
      <div class="link-group">
        <h4>Roles & Implementation</h4>
        <a href="/roles/producer">Producer</a>
        <a href="/roles/distributor">Distributor</a>
        <a href="/roles/consumer">Consumer</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} All About SBOM. All rights reserved.</p>
    {/* Optional: Render Starlight's default footer (Edit page link, next/prev arrows) below yours */}
    <div class="starlight-default-footer">
      <DefaultFooter {...Astro.props} />
    </div>
  </div>
</footer>

{/* Stretches the footer to the window edges (see .custom-footer in custom.css).
    Runs inline so the footer never paints at the narrow column width first. */}
<script is:inline>
  (() => {
    const footer = document.querySelector('.custom-footer');
    if (!footer) return;
    const fit = () => {
      footer.style.setProperty('--footer-shift', `${footer.parentElement.getBoundingClientRect().left}px`);
      footer.style.setProperty('--footer-width', `${document.documentElement.clientWidth}px`);
    };
    fit();
    addEventListener('resize', fit);
    new ResizeObserver(fit).observe(document.documentElement);
  })();
</script>